VITE_API_BASE_URL=http://localhost:3000

# Match the API flags. false = influencer skips follow/DM and admin approval.
# Set both to true and rebuild when that review should be required again.
VITE_INFLUENCER_INSTAGRAM_VERIFICATION_ENABLED=false
VITE_INFLUENCER_ADMIN_APPROVAL_REQUIRED=false
# false = brand panel hides influencer explore and campaign invites. Set true and rebuild to show them.
VITE_BRAND_INFLUENCER_DISCOVERY_ENABLED=false
# Production: set this in the Runflare dashboard before the first build, e.g.
# VITE_API_BASE_URL=https://api.example.com

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
